##
## OpenRouter is the single provider. One key, one billing account.
## Copy to .env and fill in. NEVER commit .env itself.
##

OPENROUTER_API_KEY=

## Models — see docs/ARCHITECTURE.md for the reasoning behind each choice
PARADIGM_EMBED_MODEL=google/gemini-embedding-2
PARADIGM_DECISION_MODEL=upstage/solar-decide
PARADIGM_INFERENCE_MODEL=qwen/qwen3.8-flash
PARADIGM_FALLBACK_INFERENCE_MODEL=deepseek/deepseek-v4-flash

## Database — one Postgres, one database per workspace
POSTGRES_PASSWORD=
POSTGRES_SUPERUSER=paradigm

## MinIO (S3-compatible) — credentials are generated, never published
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

## Server
PARADIGM_LOG_LEVEL=info
PARADIGM_API_PORT=8888

## Decision thresholds — calibrated automatically, see docs/THRESHOLDS.md
## These are starting values, not final ones.
PARADIGM_THRESHOLD_WRITE_GATE=0.60
PARADIGM_THRESHOLD_RERANK=0.60
PARADIGM_THRESHOLD_CROSS_WORKSPACE=0.75
