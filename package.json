{
  "name": "jove-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent self-hosted memory server for coding agents. PostgreSQL-backed, cloud-model-only.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/api/server.mjs",
    "mcp": "node src/mcp/server.mjs",
    "migrate": "node src/store/migrate.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "test:all": "npm test && npm run test:integration",
    "lint": "node scripts/lint.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "calibrate": "node src/decisions/calibrate.mjs",
    "verify": "npm run lint && npm run secret-scan && npm test",
    "key:set": "node scripts/set-provider-key.mjs",
    "key:check": "node scripts/check-provider.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
